# ==============================================================
# Daily Coding Challenge Bot — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================

# --------------------------------------------------------------
# Google Gemini AI (FREE — 1,500 requests/day, no credit card needed)
# Get your FREE key at: https://aistudio.google.com/app/apikey
# --------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------
# Telegram Bot
# Create a bot via @BotFather on Telegram to get the token.
# Get your chat ID by messaging @userinfobot on Telegram.
# --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------
# LeetCode
# Get LEETCODE_SESSION and LEETCODE_CSRF_TOKEN from browser:
#   1. Log in to leetcode.com
#   2. Open DevTools → Application → Cookies → leetcode.com
#   3. Copy the value of "LEETCODE_SESSION" cookie
#   4. Copy the value of "csrftoken" cookie
# --------------------------------------------------------------
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=

# Second LeetCode Account
LEETCODE_2_SESSION=
LEETCODE_2_CSRF_TOKEN=


# --------------------------------------------------------------
# Codeforces
# Generate API key/secret at: https://codeforces.com/settings/api
# CODEFORCES_HANDLE is your Codeforces username (e.g. tourist)
# --------------------------------------------------------------
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=
CODEFORCES_HANDLE=
CODEFORCES_PASSWORD=
# Paste the '39ce7', 'JSESSIONID', and 'X-User-Sha1' cookie values from browser DevTools:
CODEFORCES_39CE7=
CODEFORCES_JSESSIONID=
CODEFORCES_X_USER_SHA1=

# --------------------------------------------------------------
# CodeChef
# Use your regular CodeChef login credentials.
# --------------------------------------------------------------
CODECHEF_USERNAME=
CODECHEF_PASSWORD=

# --------------------------------------------------------------
# HackerRank
# Use your regular HackerRank login credentials.
# --------------------------------------------------------------
HACKERRANK_USERNAME=
HACKERRANK_PASSWORD=

# --------------------------------------------------------------
# AtCoder
# Use your regular AtCoder login credentials.
# --------------------------------------------------------------
ATCODER_USERNAME=
ATCODER_PASSWORD=


# --------------------------------------------------------------
# Bot Behaviour Settings
# DAILY_RUN_TIME  : 24-hour HH:MM format (e.g. 08:00)
# SOLUTION_LANGUAGE: python3 | cpp | java
# LOG_LEVEL       : DEBUG | INFO | WARNING | ERROR
# --------------------------------------------------------------
DAILY_RUN_TIME=08:00
SOLUTION_LANGUAGE=cpp    
LOG_LEVEL=INFO
